# Environment — contains secrets. Commit .env.example instead.
# Ignore every .env variant, then re-admit the checked-in template: listing
# them individually would miss .env.production / .env.staging, which are the
# ones carrying live credentials.
.env
.env.*
!.env.example

# Temp
*.tsbuildinfo

# Database dumps
/backups
