NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=pharmacy_db
# Migrations own the schema — run `npm run migration:run`. Leave this false.
DB_SYNCHRONIZE=false
# true for hosted Postgres (Render, Neon…) which only accept TLS.
DB_SSL=false

# Use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Read by `npm run seed:admin` only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# A variant shows up on the dashboard's low-stock list once its stock drops
# below this. One global number — there is no per-product override.
LOW_STOCK_THRESHOLD=5

# Optional. Path to a Unicode TTF covering U+09F3 so invoices can print the Taka
# sign. Without it, amounts are labelled "BDT 270.00" — pdfkit's built-in
# Helvetica has no Taka glyph and would render it as nothing at all.
# INVOICE_FONT_PATH=./assets/NotoSansBengali-Regular.ttf

# Backups (npm run backup / POST /admin/backup). Optional.
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=30
# On Windows, point these at the PostgreSQL bin folder if pg_dump is not on PATH:
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/16/bin/pg_dump.exe
# PG_RESTORE_PATH=C:/Program Files/PostgreSQL/16/bin/pg_restore.exe
